# ==============================================================================
# Turbogram - Apache Security & Hardening Configuration
# ==============================================================================

# 1. Desactivar listado de directorios
Options -Indexes

# 2. Proteger archivos sensibles y de configuración
<FilesMatch "(^\.|\.(sql|env|key|ini|log|bak|lock|json|md|git|sh|bat|zip|tar|gz|7z|phar|dist)$)">
    Require all denied
</FilesMatch>

# 3. Proteger acceso directo a carpetas internas
RewriteEngine On
RewriteRule ^(config|includes|scratch|scripts|backups|data)/ - [F,L]
RewriteRule (^|/)\.git(?:/|$) - [F,L,NC]

# 4. Cabeceras HTTP de Seguridad
<IfModule mod_headers.c>
    # Protección contra Clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # Protección contra MIME Sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Filtro XSS en navegadores heredados
    Header always set X-XSS-Protection "0"

    # Política de Referencias estricta
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Restringir permisos de hardware no necesarios
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Content-Security-Policy "base-uri 'self'; form-action 'self' https://*.mercadopago.com https://*.mercadopago.com.ar https://*.mercadopago.com.br https://*.mercadopago.com.mx https://*.mercadopago.com.co https://*.mercadopago.cl https://*.mercadopago.com.uy https://*.mercadopago.com.pe https://www.mercadopago.com https://www.mercadopago.com.ar https://mercadopago.com https://mercadopago.com.ar https://sandbox.mercadopago.com; frame-ancestors 'self'; object-src 'none'"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS

    # Ocultar cabeceras que delaten versión de PHP
    Header unset X-Powered-By
</IfModule>
